RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ %{REQUEST_SCHEME}://%1/$1 [R=301,L]

# .env ファイルへの直接アクセスを禁止
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# env_loader.php への直接アクセスを禁止
<Files "env_loader.php">
    Order allow,deny
    Deny from all
</Files>

# data ディレクトリ内の JSON ファイルへのアクセスを禁止
<FilesMatch "\.json$">
    Order allow,deny
    Deny from all
</FilesMatch>
